---
import { site } from '../lib/site';

const words = Array.from({ length: 10 }, () => site.footerText || site.name);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="marquee" aria-hidden="true">
    <div class="track">{words.map((w) => <span>{w}</span>)}</div>
    <div class="track">{words.map((w) => <span>{w}</span>)}</div>
  </div>
  <p class="visually-hidden">&copy; {year} {site.name}</p>
</footer>

<style>
  .footer {
    padding-block: 1.8rem;
    background: var(--ink);
    color: var(--white);
    border-top: 1px solid var(--white);
    overflow: hidden;
  }

  .marquee {
    display: flex;
    width: max-content;
  }

  .track {
    display: flex;
    flex-shrink: 0;
    gap: 2rem;
    padding-right: 2rem;
    font-size: var(--h2);
    line-height: 1;
    white-space: nowrap;
    animation: marquee 45s linear infinite;
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
