---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import fontLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  page?: 'home' | 'work' | 'resume' | 'contact' | null;
}

const { title, description = site.description, page = null } = Astro.props;
const pageTitle = title ? `${title} – ${site.name}` : `${site.name} – ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#111111" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Quick contact bar, shown on small phones as on the original -->
    <div class="floating-cta">
      <a class="cta-email" href={`mailto:${site.email}`}>
        <span>{site.email}</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      </a>
      {site.phone && (
        <a class="cta-phone" href={site.phoneHref}>
          <span class="visually-hidden">Call {site.phone}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
        </a>
      )}
    </div>

    <script>
      // A ring that trails the pointer, as on the original site.
      // Only for mouse and trackpad users; it never hides the real cursor.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const ring = document.createElement('div');
        ring.className = 'cursor-ring';
        ring.setAttribute('aria-hidden', 'true');
        document.body.appendChild(ring);

        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const speed = calm ? 1 : 0.15;
        let mx = 0, my = 0, x = 0, y = 0, started = false;

        document.addEventListener('pointermove', (e) => {
          mx = e.clientX;
          my = e.clientY;
          if (!started) {
            started = true;
            x = mx;
            y = my;
            ring.classList.add('is-visible');
            requestAnimationFrame(tick);
          }
        });
        document.addEventListener('pointerleave', () => ring.classList.remove('is-visible'));
        document.addEventListener('pointerenter', () => started && ring.classList.add('is-visible'));

        function tick() {
          x += (mx - x) * speed;
          y += (my - y) * speed;
          ring.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
          requestAnimationFrame(tick);
        }
      }
    </script>

    <style is:global>
      .cursor-ring {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
        width: 40px;
        height: 40px;
        border: 2px solid var(--primary);
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      .cursor-ring.is-visible {
        opacity: 1;
      }

      .menu-open,
      .menu-open body {
        overflow: hidden;
      }

      .floating-cta {
        display: none;
      }

      @media (max-width: 478px) {
        body {
          padding-bottom: 5.5rem;
        }

        .floating-cta {
          position: fixed;
          left: 0.5rem;
          right: 0.5rem;
          bottom: 0.5rem;
          z-index: 40;
          display: flex;
          gap: 0.5rem;
        }

        .floating-cta a {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 0.75rem;
          min-height: 3.5rem;
          padding: 0 1.25rem;
          border: 1px solid rgb(255 255 255 / 0.4);
          border-radius: var(--radius-xl);
          background: rgb(0 0 0 / 0.7);
          -webkit-backdrop-filter: blur(6px) saturate(0%);
          backdrop-filter: blur(6px) saturate(0%);
          color: var(--white);
          text-decoration: none;
        }

        .cta-email {
          flex: 1;
          min-width: 0;
        }

        .cta-email span {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .cta-phone {
          flex: 0 0 3.5rem;
          padding: 0 !important;
          justify-content: center !important;
        }
      }
    </style>
  </body>
</html>
